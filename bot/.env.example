# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# Render'da bu qiymatlar Dashboard → Environment bo'limiga yoziladi
# (yoki shu faylni "Secret File" sifatida .env nomi bilan yuklash mumkin).

# Telegram: @BotFather → /newbot → bergan token
BOT_TOKEN=1234567890:AAH_bu_yerga_token

# MongoDB Atlas → Connect → Drivers → ulanish satri (parolni o'zingiznikiga almashtiring)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bura

# Admin(lar)ning Telegram ID raqami, vergul bilan. ID'ni @userinfobot dan bilib olasiz.
ADMIN_IDS=123456789

# Admin panelga kirish kodi: admin bo'lsangiz ham botdagi /admin va
# Mini App'dagi Admin bo'limi shu kodni so'raydi. Murakkabroq qiling.
ADMIN_CODE=sizning-maxfiy-kodingiz

# Kod kiritilgach admin panel necha soat ochiq turadi
ADMIN_SESSION_HOURS=12

# Render'da avtomatik aniqlanadi (RENDER_EXTERNAL_URL). Boshqa joyda — https manzilingiz.
# Bo'sh bo'lsa, bot mahalliy "long polling" rejimida ishlaydi.
# PUBLIC_URL=https://bura-bot.onrender.com

# Ixtiyoriy: webhook maxfiy kaliti (bo'lmasa tokendan avtomatik hosil qilinadi)
# WEBHOOK_SECRET=
